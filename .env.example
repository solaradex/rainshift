# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PayPal
PAYPAL_ENV=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_PLAN_STARTER=your-paypal-starter-plan-id
PAYPAL_PLAN_GROWTH=your-paypal-growth-plan-id
PAYPAL_PLAN_PRO=your-paypal-pro-plan-id

# Jobber
JOBBER_CLIENT_ID=your-jobber-client-id
JOBBER_CLIENT_SECRET=your-jobber-client-secret
JOBBER_REDIRECT_URI=http://localhost:3000/api/integrations/jobber/callback
JOBBER_API_VERSION=2026-05-12
SCHEDULING_TOKEN_ENCRYPTION_KEY=64-hex-character-server-secret

# SMS
# Free MVP mode: Textbelt sends 1 free SMS per day with key=textbelt.
TEXTBELT_API_KEY=textbelt
TEXTBELT_TEST_TO_NUMBER=+15555555555
# Twilio can be added later for production volume.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_PHONE_NUMBER=
