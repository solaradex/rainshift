generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppointmentStatus {
  SCHEDULED
  MOVE
  KEEP
  REVIEW
  RESCHEDULED
  CANCELLED

  @@map("appointment_status")
}

enum WeatherSeverity {
  LOW
  MEDIUM
  HIGH

  @@map("weather_severity")
}

enum BillingStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE

  @@map("billing_status")
}

model Company {
  id             String         @id @default(cuid())
  name           String
  timezone       String         @default("America/New_York")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  ownerUserId      String?        @map("owner_user_id") @db.Uuid
  notificationPhone String?      @map("notification_phone")
  crews          Crew[]
  customers      Customer[]
  appointments   Appointment[]
  weatherEvents  WeatherEvent[]
  billingAccount BillingAccount?
  companyMembers CompanyMember[]
  notificationLogs NotificationLog[]

  @@index([ownerUserId])
  @@map("companies")
}

model CompanyMember {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id")
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("owner")
  createdAt DateTime @default(now()) @map("created_at")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
  @@map("company_members")
}

model BillingAccount {
  id                   String        @id @default(cuid())
  companyId            String        @unique @map("company_id")
  stripeCustomerId     String?       @unique @map("stripe_customer_id")
  stripeSubscriptionId  String?       @unique @map("stripe_subscription_id")
  plan                 String        @default("starter")
  status               BillingStatus @default(TRIALING)
  trialStartedAt       DateTime?     @map("trial_started_at")
  trialEndsAt          DateTime?     @map("trial_ends_at")
  currentPeriodEnd     DateTime?     @map("current_period_end")
  cancelAtPeriodEnd    Boolean       @default(false) @map("cancel_at_period_end")
  canceledAt           DateTime?     @map("canceled_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  company              Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("billing_accounts")
}

model Crew {
  id            String        @id @default(cuid())
  companyId     String        @map("company_id")
  name          String
  dailyCapacity Int           @default(480) @map("daily_capacity")
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointments  Appointment[]

  @@index([companyId])
  @@map("crews")
}

model Customer {
  id            String        @id @default(cuid())
  companyId     String        @map("company_id")
  name          String
  phone         String?
  address       String
  preferredDays String[]      @map("preferred_days")
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointments  Appointment[]

  @@index([companyId])
  @@map("customers")
}

model Appointment {
  id              String            @id @default(cuid())
  companyId       String            @map("company_id")
  customerId      String            @map("customer_id")
  crewId          String            @map("crew_id")
  service         String
  scheduledDate   DateTime          @map("scheduled_date")
  durationMinutes Int               @map("duration_minutes")
  latitude        Float?
  longitude       Float?
  status          AppointmentStatus @default(SCHEDULED)
  proposedDate    DateTime?         @map("proposed_date")
  moveReason      String?           @map("move_reason")
  approvedAt      DateTime?         @map("approved_at")
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  crew            Crew              @relation(fields: [crewId], references: [id], onDelete: Cascade)
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  notificationLogs NotificationLog[]

  @@index([companyId, scheduledDate])
  @@index([crewId, scheduledDate])
  @@map("appointments")
}

model NotificationLog {
  id                 String      @id @default(uuid()) @db.Uuid
  companyId          String      @map("company_id")
  appointmentId      String?     @map("appointment_id")
  channel            String      @default("sms")
  notificationType   String      @map("notification_type")
  destination        String
  status             String
  providerMessageId  String?     @map("provider_message_id")
  dedupeKey          String      @unique @map("dedupe_key")
  errorMessage       String?     @map("error_message")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  company            Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointment        Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@map("notification_logs")
}

model WeatherEvent {
  id              String          @id @default(cuid())
  companyId       String          @map("company_id")
  eventDate       DateTime        @map("event_date")
  rainProbability Int             @map("rain_probability")
  expectedInches  Float           @map("expected_inches")
  severity        WeatherSeverity
  createdAt       DateTime        @default(now()) @map("created_at")
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, eventDate])
  @@map("weather_events")
}
